{
  "uid": "a2a-labs-overview",
  "title": "A2A Labs Overview",
  "tags": [
    "a2a-labs"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "lab_id",
        "label": "lab_id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=~\"a2a-labs/.*\"}, job)",
          "refId": "v"
        },
        "regex": "/a2a-labs\\/(lab\\d\\d)-.*/",
        "includeAll": true,
        "allValue": "lab",
        "multi": false,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "service",
        "label": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(a2a_client_requests_total{service_name=~\"$lab_id.*\"}, service_name)",
          "refId": "v"
        },
        "regex": "",
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Client requests per method",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (rpc_method) (rate(a2a_client_requests_total{service_name=~\"$lab_id.*\", service_name=~\"$service\"}[1m]))",
          "legendFormat": "{{rpc_method}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 2,
      "title": "Client errors by A2A error code",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (a2a_error_code) (rate(a2a_client_requests_total{service_name=~\"$lab_id.*\", service_name=~\"$service\", outcome=\"error\"}[1m]))",
          "legendFormat": "{{a2a_error_code}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 3,
      "title": "Client duration p50 / p95 per agent",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, a2a_agent_name) (rate(a2a_client_duration_seconds_bucket{service_name=~\"$lab_id.*\", service_name=~\"$service\"}[5m])))",
          "legendFormat": "p50 {{a2a_agent_name}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, a2a_agent_name) (rate(a2a_client_duration_seconds_bucket{service_name=~\"$lab_id.*\", service_name=~\"$service\"}[5m])))",
          "legendFormat": "p95 {{a2a_agent_name}}",
          "refId": "B"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Task final states",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (a2a_task_final_state) (a2a_server_task_duration_seconds_count{service_name=~\"$lab_id.*\", service_name=~\"$service\"})",
          "legendFormat": "{{a2a_task_final_state}}",
          "refId": "A",
          "instant": true
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 5,
      "title": "State transitions (from \u2192 to)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (from, to) (a2a_server_task_state_transitions_total{service_name=~\"$lab_id.*\", service_name=~\"$service\"})",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 6,
      "title": "Push deliveries by outcome",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (rate(a2a_push_deliveries_total{service_name=~\"$lab_id.*\", service_name=~\"$service\"}[1m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 7,
      "title": "Decision choices per question (Nimble)",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (question, choice) (decision_choice_total{service_name=~\"$lab_id.*\", service_name=~\"$service\"})",
          "legendFormat": "{{question}}: {{choice}}",
          "refId": "A",
          "instant": true
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 8,
      "title": "Token usage by model",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (gen_ai_request_model, gen_ai_token_type) (rate(gen_ai_client_token_usage_sum{service_name=~\"$lab_id.*\", service_name=~\"$service\"}[5m]))",
          "legendFormat": "{{gen_ai_request_model}} {{gen_ai_token_type}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 9,
      "title": "Logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_namespace=\"a2a-labs\", service_name=~\"$lab_id.*\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 9
      }
    },
    {
      "id": 10,
      "title": "Traces",
      "type": "table",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.namespace = \"a2a-labs\" }",
          "limit": 20,
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 24,
        "h": 9
      }
    }
  ]
}
